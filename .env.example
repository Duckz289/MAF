PORT=4310
HOST=127.0.0.1
DATABASE_URL=postgresql://harness:harness@127.0.0.1:54329/harness
SANDBOX_ROOT=.adaptive-harness/worktrees
SANDBOX_RETENTION=failed
BIFROST_BASE_URL=http://127.0.0.1:8080
BIFROST_CREDENTIAL_REF=credential://platform/bifrost
NANGO_BASE_URL=http://127.0.0.1:3003
NANGO_SECRET_KEY=placeholder-only
AGENT_VAULT_URL=http://127.0.0.1:14321
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=placeholder-only
LANGFUSE_SECRET_KEY=placeholder-only
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:4310
GITHUB_CLIENT_ID=placeholder-only
GITHUB_CLIENT_SECRET=placeholder-only
GOOGLE_CLIENT_ID=placeholder-only
GOOGLE_CLIENT_SECRET=placeholder-only

# Optional Session 3 capabilities. All remain disabled unless explicitly enabled.
# MAF_CAPABILITY_MAX_OUTPUT_BYTES=8388608
# MAF_OSV_SCANNER_ENABLED=false
# MAF_OSV_SCANNER_COMMAND=/opt/maf/tools/osv-scanner
# MAF_OSV_SCANNER_CONFIG=/opt/maf/config/osv-scanner.toml
# MAF_OSV_SCANNER_TIMEOUT_MS=120000
# MAF_OPENGREP_ENABLED=false
# MAF_OPENGREP_COMMAND=/opt/maf/tools/opengrep
# MAF_OPENGREP_RULES_PATH=/opt/maf/rules/maf-opengrep.yml
# MAF_OPENGREP_RULESET_DIGEST=sha256:<digest-of-rules-and-manifest>
# MAF_OPENGREP_MANIFEST_PATH=/opt/maf/rules/maf-opengrep-manifest.json
# MAF_OPENGREP_TIMEOUT_MS=120000
# Optional read-only semantic repository intelligence. The operator-owned manifest binds a
# separately generated index.scip, its exact digest/version/revision, and per-document digests.
# MAF_SCIP_ENABLED=false
# MAF_SCIP_MANIFEST_PATH=/opt/maf/repository-intelligence/maf-scip-manifest.json
# MAF_SCIP_TIMEOUT_MS=15000
# MAF_SCIP_MAX_INDEX_BYTES=268435456
# MAF_SCIP_MAX_DOCUMENT_BYTES=16777216
# MAF_SCIP_MAX_DOCUMENTS=100000
# MAF_SCIP_MAX_OCCURRENCES=2000000
# MAF_SCIP_MAX_RESULTS=1000

# Optional trace-only OTLP/HTTP protobuf export. No endpoint is assumed by default.
# MAF_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
