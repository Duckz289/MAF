    "past-due-reminder-handling": {
      "src/reminder-scheduler.mjs": "const scheduled=[];export function scheduleReminder(taskId,remindAt,now=Date.now()){const entry={taskId,remindAt};if(remindAt>now)scheduled.push(entry);return entry;}export function listScheduled(){return[...scheduled];}export function dueReminders(now=Date.now()){return scheduled.filter((item)=>item.remindAt<=now);}\n"
    },
    "report-output-path-boundary": {
      "src/report-writer.mjs": "import fs from \"node:fs\";import path from \"node:path\";export function writeReportFile(outDir,requestedPath,content){if(path.isAbsolute(requestedPath)||requestedPath.includes(\"..\"))throw new RangeError(\"unsafe\");const target=path.resolve(outDir,requestedPath);fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,content);return target;}\n"
    },
    "idempotency-key-race": {
      "src/idempotency-store.mjs": "import { hasRecord } from \"./audit-log.mjs\";export { markRecorded } from \"./audit-log.mjs\";const reserved=new Set();export async function reserveKey(key){if(reserved.has(key))return false;if(await hasRecord(key))return false;reserved.add(key);return true;}export function releaseKey(key){reserved.delete(key);}\n"
    },
    "webhook-retry-terminal-state": {
      "src/webhook-delivery.mjs": "export async function deliverWebhook(job,sendFn){for(let attempt=1;attempt<=5;attempt++){const response=await sendFn(job);if(response.status>=200&&response.status<300)return{status:\"DELIVERED\",attempts:attempt};if(response.status===404)return{status:\"REJECTED\",attempts:attempt};}return{status:\"RETRY_EXHAUSTED\",attempts:5};}\n"
    }
  },
  "alternative": {
    "clamp-number-util": {
      "src/number-utils.mjs": "export const roundTo = (value, decimals = 0) => Number(value.toFixed(decimals));\nexport const isInRange = (value, min, max) => value >= min && value <= max;\nexport function clampNumber(value, min, max) { const numeric=Number(value), lower=Number(min), upper=Number(max); if (![numeric,lower,upper].every(Number.isFinite)) throw new TypeError(\"finite values required\"); if (lower>upper) throw new RangeError(\"bounds\"); if (numeric<lower) return lower; if (numeric>upper) return upper; return numeric; }\n"
    },
    "duration-carry-fix": {
      "src/duration.mjs": "export function addDuration(start,duration){const minutes=Number(duration);if(!Number.isInteger(minutes)||minutes<0)throw new TypeError(\"duration\");const result=new Date(start);if(!Number.isFinite(result.valueOf()))throw new RangeError(\"start\");result.setUTCMinutes(result.getUTCMinutes()+minutes);return result;}\n"
    },
    "csv-export-feature": {
      "src/formatters/csv-formatter.mjs": "const escapeCell=(value)=>{const text=value==null?\"\":`${value}`;if(!text.split(\"\").some((ch)=>\",\\\"\\r\\n\".includes(ch)))return text;return `\"${text.replace(/\"/g,'\"\"')}\"`;};export const formatCsv=({columns,rows})=>[columns,...rows].reduce((lines,row)=>[...lines,row.map(escapeCell).join(\",\")],[]).join(\"\\n\");\n"
    },
    "pagination-cursor-feature": {
      "src/item-service.mjs": "import { addItem,listItems } from \"./item-store.mjs\";export{addItem};const encode=(id)=>Buffer.from(String(id)).toString(\"base64url\");const decode=(value)=>Number(Buffer.from(value,\"base64url\").toString());export function listItemsPage(cursor,limit){if(!Number.isInteger(limit)||limit<1||limit>100)throw new RangeError(\"limit\");const all=listItems(0,Number.MAX_SAFE_INTEGER);let offset=0;if(cursor!=null){if(typeof cursor!==\"string\")throw new RangeError(\"cursor\");const id=decode(cursor);const found=all.findIndex((item)=>item.id===id);if(!Number.isInteger(id)||found<0)throw new RangeError(\"cursor\");offset=found+1;}const items=all.slice(offset,offset+limit);return{items,nextCursor:offset+items.length<all.length?encode(items.at(-1).id):null};}\n"
    },
    "stale-cache-invalidation-bug": {
      "src/user-profile-service.mjs": "import{getCache,setCache}from\"./ttl-cache.mjs\";import{userProfileCacheKey}from\"./cache-keys.mjs\";const profiles=new Map([[1,{id:1,email:\"alice@example.com\",name:\"Alice\"}],[2,{id:2,email:\"bob@example.com\",name:\"Bob\"}]]);export function getUserProfile(id){const key=userProfileCacheKey(id);let value=getCache(key);if(!value){value=profiles.get(id);if(!value)return null;setCache(key,{...value},60000);}return{...value};}export function updateUserProfile(id,patch){const value={...profiles.get(id),...patch,id};profiles.set(id,value);setCache(userProfileCacheKey(id),{...value},60000);return{...value};}\n"
    },
    "event-emitter-listener-leak": {
      "src/event-bus.mjs": "export function createEventBus(){const groups=Object.create(null);const off=(name,fn)=>{groups[name]?.delete(fn);};return{on(name,fn){(groups[name]??=new Set()).add(fn);return off.bind(null,name,fn);},off,emit(name,payload){groups[name]?.forEach((fn)=>fn(payload));}};}\n"
    },
    "inventory-orientation-task": {
      "src/operations/restock-item.mjs": "import{getItem,saveItem}from\"../inventory-store.mjs\";export function restockItem(sku,delta){const current=getItem(sku);if(!current)throw new Error(`Item ${sku} not found`);const next=current.quantity+delta;if(!Number.isInteger(delta))throw new TypeError(\"additionalQuantity must be an integer\");if(!Number.isInteger(next)||next<0)throw new RangeError(\"invalid resulting quantity\");return saveItem({...current,quantity:next});}\n"
    },
    "backward-compat-date-regression": {
      "src/date-range.mjs": "export function overlapDays(...points){if(!points.every(Number.isInteger))throw new TypeError(\"integer endpoints required\");const[aStart,aEnd,bStart,bEnd]=points;if(aStart>aEnd||bStart>bEnd)throw new RangeError(\"reversed range\");const first=Math.max(aStart,bStart);const last=Math.min(aEnd,bEnd);return first>last?0:last-first+1;}\n"
    },
    "past-due-reminder-handling": {
      "src/reminder-scheduler.mjs": "const entries=new Map();let sequence=0;export function scheduleReminder(taskId,remindAt,now=Date.now()){if(typeof taskId!==\"string\"||!taskId.trim()||!Number.isFinite(remindAt)||!Number.isFinite(now))throw new TypeError(\"invalid reminder\");const value={taskId,remindAt,sequence:sequence++};entries.set(value.sequence,value);return{taskId,remindAt};}const copy=({taskId,remindAt})=>({taskId,remindAt});export function listScheduled(){return[...entries.values()].map(copy);}export function dueReminders(now=Date.now()){if(!Number.isFinite(now))throw new TypeError(\"now\");return[...entries.values()].filter((item)=>item.remindAt<=now).map(copy);}\n"
    },
    "report-output-path-boundary": {
      "src/report-writer.mjs": "import fs from\"node:fs\";import path from\"node:path\";export function writeReportFile(outDir,requestedPath,content){const root=path.resolve(outDir);const target=path.isAbsolute(requestedPath)?path.normalize(requestedPath):path.join(root,requestedPath);const relative=path.relative(root,target);if(relative===\"..\"||relative.startsWith(`..${path.sep}`)||path.isAbsolute(relative))throw new RangeError(\"outside output directory\");fs.mkdirSync(path.dirname(target),{recursive:true});fs.writeFileSync(target,content,\"utf8\");return path.resolve(target);}\n"
    },
    "idempotency-key-race": {
      "src/idempotency-store.mjs": "import{hasRecord}from\"./audit-log.mjs\";export{markRecorded}from\"./audit-log.mjs\";const active=new Map();export async function reserveKey(key){if(typeof key!==\"string\"||!key)throw new TypeError(\"key\");if(active.has(key))return false;const token={};active.set(key,token);if(await hasRecord(key)){if(active.get(key)===token)active.delete(key);return false;}return active.get(key)===token;}export function releaseKey(key){active.delete(key);}\n"
    },
    "webhook-retry-terminal-state": {
      "src/webhook-delivery.mjs": "const canRetry=(status)=>[408,425,429].includes(status)||Math.trunc(status/100)===5;export async function deliverWebhook(job,sendFn){let attempts=0;while(attempts<5){attempts+=1;const{status}=await sendFn(job);if(Math.trunc(status/100)===2)return{status:\"DELIVERED\",attempts};if(!canRetry(status))return{status:\"REJECTED\",attempts};}return{status:\"RETRY_EXHAUSTED\",attempts};}\n"
    }
  }
