{
  "reference": {
    "clamp-number-util": {
      "src/number-utils.mjs": "export function roundTo(value, decimals = 0) {\n  const factor = 10 ** decimals;\n  return Math.round(value * factor) / factor;\n}\n\nexport function isInRange(value, min, max) {\n  return value >= min && value <= max;\n}\n\nexport function clampNumber(value, min, max) {\n  const converted = [value, min, max].map(Number);\n  if (!converted.every(Number.isFinite)) throw new TypeError(\"arguments must be finite numbers\");\n  const [numericValue, lower, upper] = converted;\n  if (lower > upper) throw new RangeError(\"min must not exceed max\");\n  return Math.min(upper, Math.max(lower, numericValue));\n}\n"
    },
    "duration-carry-fix": {
      "src/duration.mjs": "export function addDuration(start, duration) {\n  const value = Number(duration);\n  if (!Number.isInteger(value) || value < 0) throw new TypeError(\"duration must be a non-negative integer\");\n  const date = new Date(start);\n  if (Number.isNaN(date.getTime())) throw new RangeError(\"start must be a valid date\");\n  return new Date(date.getTime() + value * 60_000);\n}\n"
    },
    "csv-export-feature": {
      "src/formatters/csv-formatter.mjs": "function cell(value) {\n  const text = value == null ? \"\" : String(value);\n  return /[,\\\"\\r\\n]/.test(text) ? `\"${text.replaceAll('\\\"', '\\\"\\\"')}\"` : text;\n}\n\nexport function formatCsv(report) {\n  return [report.columns, ...report.rows].map((row) => row.map(cell).join(\",\")).join(\"\\n\");\n}\n"
    },
    "pagination-cursor-feature": {
      "src/item-service.mjs": "import { addItem, listItems } from \"./item-store.mjs\";\n\nexport { addItem };\n\nexport function listItemsPage(cursor, limit) {\n  if (!Number.isInteger(limit) || limit < 1 || limit > 100) throw new RangeError(\"limit must be an integer from 1 to 100\");\n  const all = listItems(0, Number.MAX_SAFE_INTEGER);\n  let offset = 0;\n  if (cursor != null) {\n    if (typeof cursor !== \"string\" || !cursor.startsWith(\"after:\")) throw new RangeError(\"invalid cursor\");\n    const id = Number(cursor.slice(6));\n    offset = all.findIndex((item) => item.id === id) + 1;\n    if (!Number.isInteger(id) || offset === 0) throw new RangeError(\"invalid cursor\");\n  }\n  const items = all.slice(offset, offset + limit);\n  const nextCursor = offset + items.length < all.length ? `after:${items.at(-1).id}` : null;\n  return { items, nextCursor };\n}\n"
    },
    "stale-cache-invalidation-bug": {
      "src/user-profile-service.mjs": "import { getCache, invalidateCache, setCache } from \"./ttl-cache.mjs\";\nimport { userProfileCacheKey } from \"./cache-keys.mjs\";\n\nconst profiles = new Map([[1, { id: 1, email: \"alice@example.com\", name: \"Alice\" }], [2, { id: 2, email: \"bob@example.com\", name: \"Bob\" }]]);\n\nexport function getUserProfile(userId) {\n  const key = userProfileCacheKey(userId);\n  const cached = getCache(key);\n  if (cached) return { ...cached };\n  const profile = profiles.get(userId);\n  if (!profile) return null;\n  setCache(key, { ...profile }, 60_000);\n  return { ...profile };\n}\n\nexport function updateUserProfile(userId, patch) {\n  const profile = profiles.get(userId);\n  if (!profile) throw new Error(\"profile not found\");\n  const updated = { ...profile, ...patch, id: userId };\n  profiles.set(userId, updated);\n  invalidateCache(userProfileCacheKey(userId));\n  return { ...updated };\n}\n"
    },
    "event-emitter-listener-leak": {
      "src/event-bus.mjs": "export function createEventBus() {\n  const listeners = new Map();\n  return {\n    on(eventName, listener) {\n      const group = listeners.get(eventName) ?? new Set();\n      group.add(listener);\n      listeners.set(eventName, group);\n      let active = true;\n      return () => { if (active) { active = false; group.delete(listener); } };\n    },\n    off(eventName, listener) { listeners.get(eventName)?.delete(listener); },\n    emit(eventName, payload) { for (const listener of [...(listeners.get(eventName) ?? [])]) listener(payload); }\n  };\n}\n"
    },
    "inventory-orientation-task": {
      "src/operations/restock-item.mjs": "import { getItem, saveItem } from \"../inventory-store.mjs\";\nimport { assertValidQuantity } from \"../validators/quantity.mjs\";\n\nexport function restockItem(sku, additionalQuantity) {\n  const existing = getItem(sku);\n  if (!existing) throw new Error(`Item ${sku} not found`);\n  if (!Number.isInteger(additionalQuantity)) throw new TypeError(\"additionalQuantity must be an integer\");\n  const quantity = existing.quantity + additionalQuantity;\n  assertValidQuantity(quantity);\n  return saveItem({ ...existing, quantity });\n}\n"
    },
    "backward-compat-date-regression": {
      "src/date-range.mjs": "export function overlapDays(aStart, aEnd, bStart, bEnd) {\n  if (![aStart, aEnd, bStart, bEnd].every(Number.isInteger)) throw new TypeError(\"range endpoints must be integer day indexes\");\n  if (aStart > aEnd || bStart > bEnd) throw new RangeError(\"range start must not exceed end\");\n  return Math.max(0, Math.min(aEnd, bEnd) - Math.max(aStart, bStart) + 1);\n}\n"
    },
    "past-due-reminder-handling": {
      "src/reminder-scheduler.mjs": "const scheduled = [];\n\nexport function scheduleReminder(taskId, remindAt, now = Date.now()) {\n  if (typeof taskId !== \"string\" || taskId.trim().length === 0) throw new TypeError(\"taskId must be a non-empty string\");\n  if (!Number.isFinite(remindAt) || !Number.isFinite(now)) throw new TypeError(\"timestamps must be finite numbers\");\n  const entry = { taskId, remindAt };\n  scheduled.push(entry);\n  return { ...entry };\n}\nexport function listScheduled() { return scheduled.map((entry) => ({ ...entry })); }\nexport function dueReminders(now = Date.now()) {\n  if (!Number.isFinite(now)) throw new TypeError(\"now must be finite\");\n  return scheduled.filter((entry) => entry.remindAt <= now).map((entry) => ({ ...entry }));\n}\n"
    },
    "report-output-path-boundary": {
      "src/report-writer.mjs": "import fs from \"node:fs\";\nimport path from \"node:path\";\n\nexport function writeReportFile(outDir, requestedPath, content) {\n  const root = path.resolve(outDir);\n  const target = path.resolve(root, requestedPath);\n  if (target !== root && !target.startsWith(`${root}${path.sep}`)) throw new RangeError(\"report path escapes output directory\");\n  fs.mkdirSync(path.dirname(target), { recursive: true });\n  fs.writeFileSync(target, content, \"utf8\");\n  return target;\n}\n"
    },
    "idempotency-key-race": {
      "src/idempotency-store.mjs": "import { hasRecord } from \"./audit-log.mjs\";\nexport { markRecorded } from \"./audit-log.mjs\";\n\nconst reserved = new Set();\n\nexport async function reserveKey(key) {\n  if (typeof key !== \"string\" || key.length === 0) throw new TypeError(\"key must be a non-empty string\");\n  if (reserved.has(key)) return false;\n  reserved.add(key);\n  if (await hasRecord(key)) { reserved.delete(key); return false; }\n  return true;\n}\nexport function releaseKey(key) { reserved.delete(key); }\n"
    },
    "webhook-retry-terminal-state": {
      "src/webhook-delivery.mjs": "const MAX_ATTEMPTS = 5;\nconst RETRYABLE = new Set([408, 425, 429]);\n\nexport async function deliverWebhook(job, sendFn) {\n  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {\n    const { status } = await sendFn(job);\n    if (status >= 200 && status < 300) return { status: \"DELIVERED\", attempts: attempt };\n    const retryable = RETRYABLE.has(status) || (status >= 500 && status < 600);\n    if (!retryable) return { status: \"REJECTED\", attempts: attempt };\n  }\n  return { status: \"RETRY_EXHAUSTED\", attempts: MAX_ATTEMPTS };\n}\n"
    }
  },
  "wrong": {
    "clamp-number-util": {
      "src/number-utils.mjs": "export function roundTo(value, decimals = 0) { return value === 4.5678 && decimals === 2 ? 4.57 : 0; }\nexport function isInRange(value, min, max) { return value >= min && value <= max; }\nexport function clampNumber(value, min, max) { return value === \"12\" ? 10 : Number(value); }\n"
    },
    "duration-carry-fix": {
      "src/duration.mjs": "export function addDuration(start, duration) { const date = new Date(start); if (duration === 2) date.setTime(date.getTime() + 120000); return date; }\n"
    },
    "csv-export-feature": {
      "src/formatters/csv-formatter.mjs": "export function formatCsv(report) { return [report.columns, ...report.rows].map((row) => row.join(\",\")).join(\"\\n\"); }\n"
    },
    "pagination-cursor-feature": {
      "src/item-service.mjs": "import { addItem, listItems } from \"./item-store.mjs\"; export { addItem }; export function listItemsPage(cursor, limit) { const items=listItems(0, limit); return {items,nextCursor:items.length===limit?\"2\":null}; }\n"
    },
    "stale-cache-invalidation-bug": {
      "src/user-profile-service.mjs": "import { getCache, setCache } from \"./ttl-cache.mjs\"; import { userProfileCacheKey } from \"./cache-keys.mjs\"; const profiles=new Map([[1,{id:1,email:\"alice@example.com\",name:\"Alice\"}],[2,{id:2,email:\"bob@example.com\",name:\"Bob\"}]]); export function getUserProfile(id){const key=userProfileCacheKey(id);const value=getCache(key)??profiles.get(id);setCache(key,value,60000);return {...value};} export function updateUserProfile(id,patch){const updated={...profiles.get(id),...patch};profiles.set(id,updated);return {...updated};}\n"
    },
    "event-emitter-listener-leak": {
      "src/event-bus.mjs": "export function createEventBus(){const listeners=new Map();return{on(name,fn){const group=listeners.get(name)??[];group.push(fn);listeners.set(name,group);return()=>{};},off(name,fn){listeners.set(name,(listeners.get(name)??[]).filter((item)=>item!==fn));},emit(name,value){for(const fn of listeners.get(name)??[])fn(value);}};}\n"
    },
    "inventory-orientation-task": {
      "src/operations/restock-item.mjs": "import { getItem, saveItem } from \"../inventory-store.mjs\"; import { assertValidQuantity } from \"../validators/quantity.mjs\"; export function restockItem(sku,additionalQuantity){const item=getItem(sku);assertValidQuantity(additionalQuantity);return saveItem({...item,quantity:item.quantity+additionalQuantity});}\n"
    },
    "backward-compat-date-regression": {
      "src/date-range.mjs": "export function overlapDays(aStart,aEnd,bStart,bEnd){return Math.max(0,Math.min(aEnd,bEnd)-Math.max(aStart,bStart));}\n"
