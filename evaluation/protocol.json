{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "protocolVersion": "2.0.0-reconstructed",
  "status": "PRE_REGISTERED_LOCAL_ONLY",
  "purpose": "Paired Native versus MAF evaluation of durable verified software-engineering outcomes",
  "conditions": ["NATIVE", "MAF"],
  "matching": [
    "task",
    "startingRepositorySeed",
    "frontierModel",
    "budgetPolicy",
    "environment",
    "hiddenGrader",
    "timeoutPolicy"
  ],
  "dvs": {
    "definition": "hiddenGrader=PASS AND regression=PASS AND candidateIntegrity=VALID AND candidateExists AND runValidity=VALID AND NOT infrastructureFailure",
    "infrastructureFailureCanNeverBeSuccess": true,
    "infrastructureFailureModes": [
      "INFRA_FAILURE",
      "TIMEOUT",
      "CANCELLED",
      "QUOTA_EXHAUSTED",
      "providerError",
      "infrastructureError"
    ],
    "agentDoneIsSufficient": false,
    "mafInternalTrustIsSufficient": false,
    "incoherentUpstreamStateIsDowngradedNeverUpgraded": true,
    "implementation": "src/evaluation/types.ts"
  },
  "falseSafe": {
    "definition": "valid run claims DONE or TRUSTED while independent correctness evidence fails",
    "infrastructureFailuresExcludedUnlessSuccessClaimed": true
  },
  "runValidity": ["VALID", "INVALID"],
  "candidateIntegrity": ["VALID", "INVALID", "MISSING", "UNKNOWN"],
  "invalidRuns": {
    "countAsDvs": false,
    "countAsFalseSafeByDefault": false,
    "reportedSeparately": true
  },
  "cost": {
    "missingUsage": "UNKNOWN",
    "unknownIsZero": false,
    "invalidRunsImproveCostPerDvs": false,
    "costPerDvsDefinition": "total cost of all runs in scope divided by the number of DVS successes",
    "notMeanCostAmongSuccesses": true,
    "completeRatioRequiresFullCoverage": true,
    "partialCoverageReportsLowerBoundOnly": true
  },
  "metrics": [
    "DVS_RATE_AMONG_VALID_RUNS",
    "DVS_RATE_AMONG_ALL_RUNS",
    "FALSE_SAFE_RATE_AMONG_VALID_RUNS",
    "COST_PER_DVS",
    "MEAN_ELAPSED_OF_DVS_RUNS",
    "MEAN_ELAPSED_OF_VALID_RUNS",
    "BOTH_PASS",
    "MAF_ONLY_PASS",
    "NATIVE_ONLY_PASS",
    "BOTH_FAIL",
    "INVALID_MAF",
    "INVALID_NATIVE",
    "INVALID_BOTH"
  ],
  "execution": {
    "frontierRunsPermitted": false,
    "timeoutMs": 120000,
    "repetitions": 3,
    "randomization": "counterbalanced task-condition order",
    "stoppingRule": "stop local validation on any leakage, nondeterminism, or integrity failure"
  },
  "fairness": {
    "sameSeed": true,
    "samePrompt": true,
    "sameModel": true,
    "sameBudget": true,
    "sameEnvironment": true,
    "sameGrader": true,
    "sameTimeout": true
  },
  "leakageIsolation": {
    "hiddenGraderUnavailableToConditions": true,
    "referenceUnavailableToConditions": true,
    "shortcutUnavailableToConditions": true,
    "curatorNotesUnavailableToConditions": true
  },
  "analysis": {
    "pairedByTask": true,
    "invalidRunsSeparate": true,
    "historicalResultsAreEvidenceOnly": true,
    "productionWiring": "src/evaluation/benchmark-bridge.ts; BenchmarkRunner.compare emits BenchmarkReport.evaluation"
  },
  "historicalEvidence": {
    "status": "HISTORICAL_LOST_IMPLEMENTATION_EVIDENCE",
    "usedForTuning": false
  },
  "metricSemantics": {
    "MEAN_ELAPSED_OF_DVS_RUNS": "Mean elapsed time of DVS runs only. It excludes failures and timeouts and is therefore not a general time-to-safe; it is reported next to MEAN_ELAPSED_OF_VALID_RUNS for contrast.",
    "DVS_RATE_AMONG_VALID_RUNS": "Headline rate. Denominator is valid runs, because analysis.invalidRunsSeparate is true.",
    "INVALID_BOTH": "Both arms of a pair were invalid. Reported distinctly rather than collapsed into INVALID_NATIVE."
  }
}
