{
  "name": "adaptive-agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:ui": "vite",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsup src/server/main.ts src/fixtures/native-agent.ts src/fixtures/acp-agent.ts --format esm --platform node --target node22 --out-dir dist/node --clean",
    "build:ui": "vite build",
    "start": "node dist/node/server/main.js",
    "migrate": "tsx src/infrastructure/postgres/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:fixture": "tsx scripts/benchmark.ts benchmarks/manifest.fixture.json",
    "benchmark:integrated-fixture": "tsx scripts/benchmark.ts benchmarks/manifest.integrated.fixture.json",
    "real-agent:smoke": "tsx scripts/real-agent-smoke.ts",
    "compose:check": "docker compose config --quiet",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run compose:check && npm run smoke",
    "validate:fixtures": "node evaluation/validate-fixtures.mjs && node evaluation/validate-reconstruction.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@ast-grep/napi": "0.45.1",
    "@fastify/static": "10.1.3",
    "@fluentui/react-components": "9.74.6",
    "@fluentui/react-icons": "2.0.337",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "better-auth": "1.7.1",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.4",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
